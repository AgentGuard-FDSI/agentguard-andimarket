# Copia este archivo como .env (ya está en el .gitignore) y completa solo lo que vayas a usar.
# Nunca subas llaves reales al repositorio. Sin llaves, todo funciona con el modo simulado.

# --- Modelo -------------------------------------------------------------------------------
# simulado | gemini | groq | ollama
MODEL_BACKEND=simulado
# Temperatura fija por corrida; la misma en Config. A y Config. B (sección 4 de la propuesta).
MODEL_TEMPERATURE=0

# Gemini (Google AI Studio, cuota gratuita sin tarjeta): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (cuota gratuita): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, sin llave): instalar Ollama y ejecutar `ollama pull llama3.1`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Bases de datos (las lee tools/db.py) --------------------------------------------------
ANDIMARKET_DB=data/andimarket_trabajo.db
ANDIMARKET_EVIDENCIA_DB=data/andimarket_evidencia.db
ANDIMARKET_MAX_FILAS=50
